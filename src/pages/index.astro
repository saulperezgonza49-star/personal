---
import Layout from "../layouts/Layout.astro";
import mascotasJson from "../data/mascotas.json";
import { createClient } from "@supabase/supabase-js";

// Credenciales de Supabase
const supabaseUrl =
	import.meta.env.PUBLIC_SUPABASE_URL ||
	"https://crhvxeidbjfyenyynmnr.supabase.co";
const supabaseKey =
	import.meta.env.PUBLIC_SUPABASE_ANON_KEY ||
	"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNyaHZ4ZWlkYmpmeWVueXlubW5yIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE5MTQ4OTQsImV4cCI6MjA5NzQ5MDg5NH0._0j3BdcANWt3kYQhzT2_kt-W8DyGD5AvTpAi4I7MYgc";
const supabase = createClient(supabaseUrl, supabaseKey);

// Consultar mascotas dinámicas desde Supabase
const { data: dbMascotas } = await supabase
	.from("mascotas")
	.select("*")
	.order("created_at", { ascending: true });

// Formatear las mascotas de la base de datos para que coincidan con la estructura
const mascotasDbFormateadas = (dbMascotas || []).map((m) => ({
	id: m.id,
	navName: m.name,
	phrase: m.phrase || "Un angelito que siempre nos acompañará.",
}));

// Filtrar posibles duplicados si el id ya existía en el JSON local
const idsJson = new Set(mascotasJson.map((m) => m.id));
const mascotasExtra = mascotasDbFormateadas.filter((m) => !idsJson.has(m.id));

// Unir todas las mascotas
const todasLasMascotas = [...mascotasJson, ...mascotasExtra];

// Pequeña variación de inclinación para que cada tarjeta se sienta puesta
// a mano en el álbum, no una copia idéntica de la anterior.
const inclinaciones = [
	"-rotate-2",
	"rotate-1",
	"rotate-2",
	"-rotate-1",
	"rotate-2",
	"-rotate-2",
];
const acentos = ["bg-rose", "bg-sage", "bg-rose", "bg-sage"];
---

<Layout title="Un álbum de recuerdos hermosos 🤍">
	<main class="min-h-screen py-16 md:py-24 px-4">
		<!-- Encabezado -->
		<div class="max-w-xl mx-auto text-center mb-16 md:mb-20">
			<span class="text-3xl">🕊️</span>
			<h1
				class="font-serif text-4xl md:text-5xl text-ink mt-5 leading-[1.15]"
			>
				Un álbum para las historias
				<em class="not-italic font-serif italic text-rose-dark"
					>que siguen vivas</em
				>
			</h1>
			<p
				class="text-taupe text-base md:text-lg leading-relaxed mt-5 max-w-md mx-auto"
			>
				Cada compañero tiene su propio rincón aquí: sus fotos, su frase,
				y los momentos que no queremos que el tiempo se lleve.
			</p>
		</div>

		<!-- Álbum: grid de tarjetas tipo polaroid -->
		<div
			class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-10 max-w-4xl mx-auto w-full px-4"
		>
			{
				todasLasMascotas.map((mascota, i) => (
					<a
						href={`/mascota/${mascota.id}`}
						class={`group relative block bg-paper p-4 pb-6 shadow-[0_8px_24px_-6px_rgba(58,46,40,0.25)] transition-all duration-300 hover:rotate-0 hover:-translate-y-1.5 hover:shadow-[0_14px_32px_-8px_rgba(58,46,40,0.3)] ${inclinaciones[i % inclinaciones.length]}`}
					>
						{/* Cinta washi decorativa */}
						<span
							class={`absolute -top-2.5 left-1/2 -translate-x-1/2 w-10 h-4 rotate-1 opacity-80 ${acentos[i % acentos.length]}`}
						/>

						{/* "Foto" del recuerdo */}
						<div class="aspect-square bg-parchment flex items-center justify-center text-5xl">
							🐾
						</div>

						<div class="text-center mt-4">
							<h2 class="font-serif text-lg text-ink">
								{mascota.navName}
							</h2>
							<p class="text-taupe text-xs mt-2 italic leading-relaxed line-clamp-2">
								"{mascota.phrase}"
							</p>
						</div>
					</a>
				))
			}

			<!-- Casilla vacía del álbum: agregar mascota nueva -->
			<button
				id="open-pet-modal-btn"
				class="group relative block bg-transparent p-4 pb-6 border-2 border-dashed border-taupe/30 hover:border-rose/60 transition-colors duration-300 cursor-pointer"
			>
				<div
					class="aspect-square flex items-center justify-center text-3xl text-taupe/40 group-hover:text-rose transition-colors"
				>
					➕
				</div>
				<div class="text-center mt-4">
					<p
						class="font-serif text-sm text-taupe/70 group-hover:text-rose-dark transition-colors"
					>
						Agregar un compañero
					</p>
				</div>
			</button>
		</div>

		<!-- Modal para crear una nueva mascota -->
		<div
			id="new-pet-modal"
			class="fixed inset-0 bg-ink/50 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden"
		>
			<div
				class="bg-paper rounded-2xl p-6 md:p-8 max-w-md w-full shadow-xl border border-ink/5 relative"
			>
				<h3 class="font-serif text-2xl text-ink mb-2">
					Un nuevo espacio de recuerdos
				</h3>
				<p class="text-taupe text-sm mb-6">
					Agrega el nombre y una frase dedicada para crear una nueva
					página de recuerdos.
				</p>

				<div class="space-y-4">
					<div>
						<label
							class="block text-xs font-medium text-taupe mb-1"
						>
							Nombre de la mascota
						</label>
						<input
							type="text"
							id="new-pet-name"
							placeholder="Ej. Pelusa, Manchas..."
							class="w-full px-4 py-3 rounded-xl border border-ink/10 focus:outline-none focus:ring-2 focus:ring-rose/40 focus:border-rose text-ink text-sm bg-parchment/40"
						/>
					</div>

					<div>
						<label
							class="block text-xs font-medium text-taupe mb-1"
						>
							Frase o mensaje especial
						</label>
						<textarea
							id="new-pet-phrase"
							rows="3"
							placeholder="Ej. Siempre iluminaste nuestra casa con tus alegrías..."
							class="w-full px-4 py-3 rounded-xl border border-ink/10 focus:outline-none focus:ring-2 focus:ring-rose/40 focus:border-rose text-ink text-sm bg-parchment/40 resize-none"
						></textarea>
					</div>
				</div>

				<div class="flex gap-3 mt-6">
					<button
						id="close-pet-modal-btn"
						class="w-1/2 py-3 rounded-xl border border-ink/10 text-taupe text-sm font-medium hover:bg-parchment transition-all cursor-pointer"
					>
						Cancelar
					</button>
					<button
						id="save-pet-btn"
						class="w-1/2 py-3 rounded-xl bg-rose hover:bg-rose-dark text-white text-sm font-medium transition-all shadow-sm cursor-pointer"
					>
						Crear espacio
					</button>
				</div>
			</div>
		</div>
	</main>
</Layout>

<script define:vars={{ supabaseUrl, supabaseKey }}>
	window.addEventListener("DOMContentLoaded", () => {
		const openBtn = document.getElementById("open-pet-modal-btn");
		const closeBtn = document.getElementById("close-pet-modal-btn");
		const saveBtn = document.getElementById("save-pet-btn");
		const modal = document.getElementById("new-pet-modal");
		const nameInput = document.getElementById("new-pet-name");
		const phraseInput = document.getElementById("new-pet-phrase");

		openBtn?.addEventListener("click", () => {
			if (nameInput) nameInput.value = "";
			if (phraseInput) phraseInput.value = "";
			modal?.classList.remove("hidden");
		});

		closeBtn?.addEventListener("click", () => {
			modal?.classList.add("hidden");
		});

		saveBtn?.addEventListener("click", async () => {
			const name = nameInput?.value.trim();
			const phrase = phraseInput?.value.trim();

			if (!name) {
				alert("Por favor escribe el nombre de la mascota.");
				return;
			}

			const id =
				name
					.toLowerCase()
					.normalize("NFD")
					.replace(/[\u0300-\u036f]/g, "")
					.replace(/[^a-z0-9]/g, "-")
					.replace(/-+/g, "-")
					.replace(/^-|-$/g, "") +
				"-" +
				Date.now().toString().slice(-4);

			try {
				const response = await fetch(
					`${supabaseUrl}/rest/v1/mascotas`,
					{
						method: "POST",
						headers: {
							"Content-Type": "application/json",
							apikey: supabaseKey,
							Authorization: `Bearer ${supabaseKey}`,
						},
						body: JSON.stringify({
							id: id,
							name: name,
							phrase:
								phrase ||
								"Un angelito que siempre nos acompañará.",
						}),
					},
				);

				if (response.ok) {
					window.location.href = `/mascota/${id}`;
				} else {
					const errText = await response.text();
					console.error("Error al crear mascota:", errText);
					alert("Hubo un error al guardar la mascota en Supabase.");
				}
			} catch (err) {
				console.error(err);
				alert("Error de conexión al intentar guardar la mascota.");
			}
		});
	});
</script>
