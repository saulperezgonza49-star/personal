---
import Layout from "../layouts/Layout.astro";
import mascotasJson from "../data/mascotas.json";
import { createClient } from "@supabase/supabase-js";

// Credenciales de Supabase
const supabaseUrl =
	import.meta.env.PUBLIC_SUPABASE_URL ||
	"https://crhvxeidbjfyenyynmnr.supabase.co";
const supabaseKey =
	import.meta.env.PUBLIC_SUPABASE_ANON_KEY ||
	"eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNyaHZ4ZWlkYmpmeWVueXlubW5yIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE5MTQ4OTQsImV4cCI6MjA5NzQ5MDg5NH0._0j3BdcANWt3kYQhzT2_kt-W8DyGD5AvTpAi4I7MYgc";
const supabase = createClient(supabaseUrl, supabaseKey);

// Consultar mascotas dinámicas desde Supabase
const { data: dbMascotas } = await supabase
	.from("mascotas")
	.select("*")
	.order("created_at", { ascending: true });

// Formatear las mascotas de la base de datos para que coincidan con la estructura
const mascotasDbFormateadas = (dbMascotas || []).map((m) => ({
	id: m.id,
	navName: m.name,
	phrase: m.phrase || "Un angelito que siempre nos acompañará.",
}));

// Filtrar posibles duplicados si el id ya existía en el JSON local
const idsJson = new Set(mascotasJson.map((m) => m.id));
const mascotasExtra = mascotasDbFormateadas.filter((m) => !idsJson.has(m.id));

// Unir todas las mascotas
const todasLasMascotas = [...mascotasJson, ...mascotasExtra];
---

<Layout title="Nuestro rincón de recuerdos hermosos 🤍">
	<main
		class="min-h-screen flex flex-col justify-center bg-gradient-to-b from-amber-50/40 to-stone-50 py-16 px-4"
	>
		<!-- Encabezado -->
		<div class="max-w-2xl mx-auto text-center z-10 mb-12">
			<span
				class="text-xs font-semibold uppercase tracking-widest text-amber-700 bg-amber-100/60 px-3 py-1 rounded-full"
				>Memorial Colectivo</span
			>
			<h1 class="text-4xl md:text-5xl font-bold text-stone-900 mt-4 mb-4">
				El rincón de sus recuerdos
			</h1>
			<p
				class="text-stone-600 text-base md:text-lg leading-relaxed max-w-lg mx-auto"
			>
				Los lazos que creamos con ellos son eternos. Selecciona a uno de
				nuestros compañeros para recordar las huellas de felicidad que
				dejaron en nuestras vidas.
			</p>

			<!-- Botón para añadir una nueva mascota -->
			<div class="mt-8">
				<button
					id="open-pet-modal-btn"
					class="bg-amber-600 hover:bg-amber-700 text-white font-medium px-6 py-3 rounded-full shadow-sm hover:shadow transition-all duration-300 inline-flex items-center gap-2 text-sm cursor-pointer"
				>
					➕ Agregar un nuevo compañero
				</button>
			</div>
		</div>

		<!-- Grid de tarjetas de mascotas -->
		<div class="grid sm:grid-cols-3 gap-6 max-w-4xl mx-auto w-full px-4">
			{
				todasLasMascotas.map((mascota) => (
					<a
						href={`/mascota/${mascota.id}`}
						class="bg-white border border-stone-200/80 p-6 rounded-2xl text-center shadow-sm hover:shadow-md hover:border-amber-300 hover:-translate-y-1 transition-all duration-300 group flex flex-col justify-between h-48"
					>
						<div>
							<div class="text-3xl mb-3 group-hover:scale-110 transition-transform duration-300">
								{mascota.id === "gatito-principal"
									? "🕊️"
									: "🐾"}
							</div>
							<h2 class="font-serif text-lg font-bold text-stone-800 group-hover:text-amber-800 transition-colors">
								{mascota.navName}
							</h2>
							<p class="text-xs text-stone-500 mt-2 line-clamp-2 italic">
								"{mascota.phrase}"
							</p>
						</div>
						<span class="text-xs font-semibold text-amber-600 uppercase tracking-wider mt-4 inline-block">
							Ver recuerdos →
						</span>
					</a>
				))
			}
		</div>

		<!-- Modal para crear una nueva mascota -->
		<div
			id="new-pet-modal"
			class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden"
		>
			<div
				class="bg-white rounded-3xl p-6 md:p-8 max-w-md w-full shadow-xl border border-stone-100 relative"
			>
				<h3 class="text-2xl font-bold text-stone-800 mb-2">
					Crear espacio para una mascota 🐾
				</h3>
				<p class="text-stone-500 text-sm mb-6">
					Agrega el nombre y una frase dedicada para crear una nueva
					página de recuerdos.
				</p>

				<div class="space-y-4">
					<div>
						<label
							class="block text-xs font-semibold uppercase text-stone-500 mb-1"
							>Nombre de la mascota</label
						>
						<input
							type="text"
							id="new-pet-name"
							placeholder="Ej. Pelusa, Manchas..."
							class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:outline-none focus:ring-2 focus:ring-amber-500 text-stone-800 text-sm"
						/>
					</div>

					<div>
						<label
							class="block text-xs font-semibold uppercase text-stone-500 mb-1"
							>Frase o mensaje especial</label
						>
						<textarea
							id="new-pet-phrase"
							rows="3"
							placeholder="Ej. Siempre iluminaste nuestra casa con tus alegrías..."
							class="w-full px-4 py-3 rounded-xl border border-stone-200 focus:outline-none focus:ring-2 focus:ring-amber-500 text-stone-800 text-sm resize-none"
						></textarea>
					</div>
				</div>

				<div class="flex gap-3 mt-6">
					<button
						id="close-pet-modal-btn"
						class="w-1/2 py-3 rounded-xl border border-stone-200 text-stone-600 text-sm font-medium hover:bg-stone-50 transition-all cursor-pointer"
					>
						Cancelar
					</button>
					<button
						id="save-pet-btn"
						class="w-1/2 py-3 rounded-xl bg-amber-600 hover:bg-amber-700 text-white text-sm font-medium transition-all shadow-sm cursor-pointer"
					>
						Crear espacio ✨
					</button>
				</div>
			</div>
		</div>
	</main>
</Layout>

<script define:vars={{ supabaseUrl, supabaseKey }}>
	window.addEventListener("DOMContentLoaded", () => {
		const openBtn = document.getElementById("open-pet-modal-btn");
		const closeBtn = document.getElementById("close-pet-modal-btn");
		const saveBtn = document.getElementById("save-pet-btn");
		const modal = document.getElementById("new-pet-modal");
		const nameInput = document.getElementById("new-pet-name");
		const phraseInput = document.getElementById("new-pet-phrase");

		openBtn?.addEventListener("click", () => {
			if (nameInput) nameInput.value = "";
			if (phraseInput) phraseInput.value = "";
			modal?.classList.remove("hidden");
		});

		closeBtn?.addEventListener("click", () => {
			modal?.classList.add("hidden");
		});

		saveBtn?.addEventListener("click", async () => {
			const name = nameInput?.value.trim();
			const phrase = phraseInput?.value.trim();

			if (!name) {
				alert("Por favor escribe el nombre de la mascota.");
				return;
			}

			const id =
				name
					.toLowerCase()
					.normalize("NFD")
					.replace(/[\u0300-\u036f]/g, "")
					.replace(/[^a-z0-9]/g, "-")
					.replace(/-+/g, "-")
					.replace(/^-|-$/g, "") +
				"-" +
				Date.now().toString().slice(-4);

			try {
				const response = await fetch(
					`${supabaseUrl}/rest/v1/mascotas`,
					{
						method: "POST",
						headers: {
							"Content-Type": "application/json",
							apikey: supabaseKey,
							Authorization: `Bearer ${supabaseKey}`,
						},
						body: JSON.stringify({
							id: id,
							name: name,
							phrase:
								phrase ||
								"Un angelito que siempre nos acompañará.",
						}),
					},
				);

				if (response.ok) {
					window.location.href = `/mascota/${id}`;
				} else {
					const errText = await response.text();
					console.error("Error al crear mascota:", errText);
					alert("Hubo un error al guardar la mascota en Supabase.");
				}
			} catch (err) {
				console.error(err);
				alert("Error de conexión al intentar guardar la mascota.");
			}
		});
	});
</script>
