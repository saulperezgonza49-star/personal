---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Plus+Jakarta+Sans:wght@300;400;600&display=swap" rel="stylesheet">
	</head>
	<body class="bg-stone-50 text-stone-800 font-sans selection:bg-amber-100">
		<slot />
	</body>
</html>

<style is:global>
	body {
		font-family: 'Plus Jakarta Sans', sans-serif;
	}
	h1, h2, h3 {
		font-family: 'Lora', serif;
	}
</style>