---
import AudioPlayer from "../components/AudioPlayer.astro";
import Navbar from "../components/Navbar.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!--dnctype html-->
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta
			name="description"
			content="Un espacio de recuerdos hermosos para nuestras mascotas."
		/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body
		class="bg-parchment text-ink min-h-screen flex flex-col font-sans antialiased selection:bg-rose/30 selection:text-rose-dark"
	>
		<!-- 🧭 Barra de navegación global (aparece en TODAS las páginas) -->
		<Navbar />

		<!-- Contenido principal de cada página -->
		<div class="flex-grow">
			<slot />
		</div>

		<!-- 🎵 Reproductor de Spotify global (Aparece en TODAS las páginas) -->
		<AudioPlayer />
	</body>
</html>
