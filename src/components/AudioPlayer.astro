---
// Componente de Reproductor de Música Flotante de Spotify (Soporta links intl-es)
// Usa la API oficial de Spotify (IFrame API) para poder controlar play/pause
// de verdad, y así pausarse automáticamente cuando alguien reproduce un video
// de recuerdos.
---

<div class="fixed bottom-4 right-4 z-40 flex flex-col items-end gap-2">
  <!-- Ventana emergente para pegar el enlace de Spotify -->
  <div
    id="music-popover"
    class="hidden bg-paper/95 backdrop-blur-md p-4 rounded-3xl shadow-2xl border border-ink/10 w-[min(18rem,calc(100vw-2rem))] max-h-[80vh] overflow-y-auto transition-all duration-200 animate-in fade-in slide-in-from-bottom-2"
  >
    <div class="flex items-center justify-between mb-2">
      <span class="text-xs font-bold text-ink flex items-center gap-1.5">
        <span class="text-emerald-500 text-sm">🟢</span> Música de Spotify
      </span>
      <button
        id="close-popover-btn"
        class="text-taupe/70 hover:text-taupe text-xs px-1.5 py-0.5 rounded-full cursor-pointer"
      >
        ✕
      </button>
    </div>

    <p class="text-taupe text-[11px] leading-relaxed mb-3">
      Pega un enlace de tu canción o lista favorita de <strong>Spotify</strong> para
      escucharla mientras visitas la página:
    </p>

    <!-- Formulario de enlace de Spotify -->
    <div class="flex gap-2 mb-3">
      <input
        type="text"
        id="spotify-url-input"
        placeholder="https://open.spotify.com/..."
        class="w-full px-3 py-2 rounded-xl border border-ink/10 text-xs focus:outline-none focus:ring-2 focus:ring-emerald-500/50 focus:border-emerald-500 bg-parchment/40"
      />
      <button
        id="apply-spotify-btn"
        class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-3.5 py-2 rounded-xl font-medium transition-all active:scale-95 flex-shrink-0 cursor-pointer shadow-xs"
      >
        Poner
      </button>
    </div>

    <!-- Contenedor del reproductor embed de Spotify (la API mete su iframe aquí) -->
    <div
      id="spotify-player-container"
      class="rounded-2xl overflow-hidden hidden border border-ink/5 shadow-sm mt-2"
      style="height: 152px;"
    >
      <div id="spotify-embed-target"></div>
    </div>
  </div>

  <!-- Botón Flotante Principal -->
  <button
    id="music-toggle-btn"
    class="bg-paper/90 backdrop-blur-md hover:bg-emerald-50/60 text-ink border border-emerald-200/60 px-4 py-2.5 rounded-full shadow-lg transition-all duration-300 flex items-center gap-2 text-xs sm:text-sm font-medium cursor-pointer active:scale-95 group"
    title="Poner canción de Spotify"
  >
    <span
      id="music-icon"
      class="text-base group-hover:scale-110 transition-transform">🎧</span
    >
    <span id="music-text">Elegir música de Spotify</span>
  </button>
</div>

<!-- API oficial de Spotify: necesaria para poder pausar el reproductor desde JS -->
<script is:inline src="https://open.spotify.com/embed/iframe-api/v1" async
></script>

<script>
  window.addEventListener("DOMContentLoaded", () => {
    const musicBtn = document.getElementById("music-toggle-btn");
    const musicPopover = document.getElementById("music-popover");
    const closePopoverBtn = document.getElementById("close-popover-btn");
    const urlInput = document.getElementById(
      "spotify-url-input",
    ) as HTMLInputElement;
    const applyBtn = document.getElementById("apply-spotify-btn");
    const playerContainer = document.getElementById("spotify-player-container");
    const embedTarget = document.getElementById("spotify-embed-target");
    const musicText = document.getElementById("music-text");
    const musicIcon = document.getElementById("music-icon");

    // Controller de la API de Spotify. Se crea una sola vez; después solo
    // le pedimos que cargue una URI distinta con loadUri().
    let spotifyController: any = null;
    let apiReady = false;
    let pendingUri: string | null = null;

    // Se expone en window para que cualquier otra parte del sitio (por
    // ejemplo, el código que reproduce videos de recuerdos) pueda pausar
    // la música sin necesidad de conocer los detalles de Spotify.
    (window as any).__pauseSpotifyMusic = () => {
      spotifyController?.pause();
    };

    // Convierte cualquier link de Spotify (con o sin /intl-es/, embed o no)
    // a un URI tipo "spotify:track:ID", que es lo que pide la IFrame API.
    const getSpotifyUri = (url: string): string => {
      if (!url || !url.includes("spotify.com")) return "";
      const match = url.match(
        /(track|playlist|album|artist|episode|show)\/([a-zA-Z0-9]+)/,
      );
      if (match && match[1] && match[2]) {
        return `spotify:${match[1]}:${match[2]}`;
      }
      return "";
    };

    const startOrUpdatePlayer = (uri: string) => {
      if (spotifyController) {
        spotifyController.loadUri(uri);
        spotifyController.play();
        return;
      }
      // Todavía no hay controller: guardamos la uri, la API la recoge
      // en cuanto esté lista (ver onSpotifyIframeApiReady más abajo).
      pendingUri = uri;
      if (apiReady) createController();
    };

    const createController = () => {
      const IFrameAPI = (window as any).__spotifyIFrameAPI;
      if (!IFrameAPI || !embedTarget || !pendingUri) return;
      IFrameAPI.createController(
        embedTarget,
        { uri: pendingUri, width: "100%", height: "152" },
        (controller: any) => {
          spotifyController = controller;
          pendingUri = null;
        },
      );
    };

    // Callback global que llama la API de Spotify cuando termina de cargar.
    (window as any).onSpotifyIframeApiReady = (IFrameAPI: any) => {
      (window as any).__spotifyIFrameAPI = IFrameAPI;
      apiReady = true;
      if (pendingUri) createController();
    };

    const loadSpotifyTrack = (url: string) => {
      const uri = getSpotifyUri(url);
      if (uri && playerContainer) {
        playerContainer.classList.remove("hidden");
        startOrUpdatePlayer(uri);
        if (musicText) musicText.innerText = "Spotify activo 🎶";
        if (musicIcon) musicIcon.innerText = "🎶";
        localStorage.setItem("custom_spotify_music", url);
      } else {
        alert("Asegúrate de pegar un enlace válido de Spotify 🟢");
      }
    };

    // Cargar canción previa si existe
    const savedUrl = localStorage.getItem("custom_spotify_music");
    if (savedUrl) {
      if (urlInput) urlInput.value = savedUrl;
      loadSpotifyTrack(savedUrl);
    }

    // Toggle Popover
    musicBtn?.addEventListener("click", () => {
      musicPopover?.classList.toggle("hidden");
    });

    closePopoverBtn?.addEventListener("click", () => {
      musicPopover?.classList.add("hidden");
    });

    // Guardar y aplicar
    applyBtn?.addEventListener("click", () => {
      const inputUrl = urlInput?.value.trim();
      if (inputUrl) {
        loadSpotifyTrack(inputUrl);
      }
    });

    // 🎬 Pausar Spotify automáticamente cuando cualquier video de recuerdos
    // empieza a reproducirse. Usamos "capture" porque el evento "play" de
    // <video> no hace bubbling, así que hay que escucharlo en la fase de
    // captura para atrapar videos creados dinámicamente también.
    document.addEventListener(
      "play",
      (e) => {
        const target = e.target as HTMLElement;
        if (target?.tagName === "VIDEO") {
          (window as any).__pauseSpotifyMusic?.();
        }
      },
      true,
    );
  });
</script>
