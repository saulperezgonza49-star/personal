---
import mascotasJson from "../data/mascotas.json";
import { createClient } from "@supabase/supabase-js";

interface MascotaLocal {
  id: string;
  name: string;
  navName: string;
  phrase: string;
  memories: any[];
}
const mascotasLocales = mascotasJson as MascotaLocal[];

const supabaseUrl =
  import.meta.env.PUBLIC_SUPABASE_URL ||
  "https://crhvxeidbjfyenyynmnr.supabase.co";
const supabaseKey =
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY ||
  "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNyaHZ4ZWlkYmpmeWVueXlubW5yIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE5MTQ4OTQsImV4cCI6MjA5NzQ5MDg5NH0._0j3BdcANWt3kYQhzT2_kt-W8DyGD5AvTpAi4I7MYgc";
const supabase = createClient(supabaseUrl, supabaseKey);

const { data: dbMascotas } = await supabase
  .from("mascotas")
  .select("id, name")
  .order("created_at", { ascending: true });

const dbPorId = new Map((dbMascotas || []).map((m) => [m.id, m.name]));
const mascotasBase = mascotasLocales.map((m) =>
  dbPorId.has(m.id) ? { ...m, navName: dbPorId.get(m.id) } : m,
);

const idsJson = new Set(mascotasLocales.map((m) => m.id));
const mascotasExtra = (dbMascotas || [])
  .filter((m) => !idsJson.has(m.id))
  .map((m) => ({ id: m.id, navName: m.name }));

const mascotas = [...mascotasBase, ...mascotasExtra];
---

<nav
  class="sticky top-0 z-50 bg-paper/85 backdrop-blur-md border-b border-ink/10 px-4 sm:px-6 py-3"
>
  <div
    class="max-w-5xl mx-auto flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 sm:gap-4"
  >
    <a
      href="/"
      class="font-serif text-base sm:text-lg text-ink hover:text-rose-dark transition-colors shrink-0"
    >
      🤍 Nuestros Compañeros
    </a>

    <div
      class="flex gap-4 overflow-x-auto whitespace-nowrap text-sm font-medium text-taupe -mx-1 px-1 pb-0.5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      {
        mascotas.map((mascota) => (
          <a
            href={`/mascota/${mascota.id}`}
            class="shrink-0 hover:text-rose-dark transition-colors"
          >
            {mascota.navName}
          </a>
        ))
      }
    </div>
  </div>
</nav>
