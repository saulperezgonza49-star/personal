---
interface Props {
    title: string;
    date: string;
    description: string;
    image: string;
}

const { title, date, description, image } = Astro.props;
---

<div class="bg-white rounded-2xl shadow-sm border border-stone-100 overflow-hidden hover:shadow-md transition-all duration-300 group">
  <div class="overflow-hidden aspect-video">
    <img 
      src={image} 
      alt={title} 
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
  </div>
  <div class="p-6">
    <span class="text-xs font-semibold text-amber-600/80 tracking-wide uppercase">{date}</span>
    <h3 class="text-xl font-bold text-stone-800 mt-1 mb-2">{title}</h3>
    <p class="text-stone-600 text-sm leading-relaxed whitespace-pre-line">{description}</p>
  </div>
</div>