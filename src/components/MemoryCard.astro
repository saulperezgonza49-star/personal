---
interface Props {
  id: string | number;
  title: string;
  date: string;
  description: string;
  mediaUrl: string;
  isVideo?: boolean; // Un booleano opcional para saber si es video
}

const { id, title, date, description, mediaUrl, isVideo = false } = Astro.props;
---

<div
  class="memory-card relative bg-paper rounded-2xl shadow-sm border border-ink/5 overflow-hidden hover:shadow-md transition-all duration-300"
  data-memory-id={id}
>
  <button
    type="button"
    class="delete-memory-btn absolute top-2 right-2 z-10 bg-stone-900/60 hover:bg-red-600 text-white w-8 h-8 rounded-full flex items-center justify-center text-sm transition-all cursor-pointer active:scale-95"
    title="Borrar este recuerdo"
    aria-label="Borrar este recuerdo"
  >
    🗑️
  </button>
  <div
    class="overflow-hidden aspect-video bg-stone-900 flex items-center justify-center"
  >
    {
      isVideo ? (
        <video
          src={mediaUrl}
          controls
          preload="metadata"
          class="w-full h-full object-cover"
        />
      ) : (
        <img
          src={mediaUrl}
          alt={title}
          class="w-full h-full object-cover hover:scale-103 transition-transform duration-500"
        />
      )
    }
  </div>
  <div class="p-6">
    <span class="text-xs font-semibold text-rose tracking-wide uppercase"
      >{date}</span
    >
    <h3 class="font-serif text-xl text-ink mt-1 mb-2">{title}</h3>
    <p class="text-taupe text-sm leading-relaxed whitespace-pre-line">
      {description}
    </p>
  </div>
</div>
